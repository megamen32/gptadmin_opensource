[Unit]
Description=GPTAdmin CloudOS local agent
After=network-online.target

[Service]
ExecStart=/usr/bin/python3 /home/roomhacker/.local/lib/gptadmin-cloudos/agent.py --hub http://127.0.0.1:9001/api/v1/cloud-os --name node-100 --os linux --listen 127.0.0.1:9137 --root /home/roomhacker/gptadmin --state /home/roomhacker/.local/share/gptadmin-cloudos/node-100.json
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
