[Unit]
Description=GPTAdmin local ShellMCP exit HTTP proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=%i
EnvironmentFile=/etc/gptadmin/networkproxy-exit.env
ExecStart=/usr/local/bin/networkproxy-exit -hub ${HUB_URL} -relay ${RELAY_URL} -ctl-token-file ${CTL_TOKEN_FILE} -nodes-file ${NODES_FILE}
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/etc/gptadmin

[Install]
WantedBy=multi-user.target
