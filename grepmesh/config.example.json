    "overall_timeout_ms": 5000,
    "max_file_bytes": 16777216
  },
  "exclude_globs": [],
  "topology_cache_path": "/var/lib/grepmesh-mcp/topology.json",
  "gptadmin_topology_url": "https://gptadmin.internal/mcp-relay/grepmesh",
  "gptadmin_token_env": "GPTADMIN_GREPMESH_TOKEN",
  "peer_auth_token_env": "GREPMESH_PEER_TOKEN",
  "topology_ttl_ms": 30000
