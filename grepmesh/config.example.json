{
  "host_id": "server-100",
  "bind": "203.0.113.10:9419",
  "local_bind": "127.0.0.1:9419",
  "root": "/home/admin",
  "roots": {
    "home": ["/home/admin"],
    "opt": ["/opt"],
    "etc": ["/etc"]
  },
  "peers": [
    {
      "host_id": "server-88",
      "local_url": "http://127.0.0.1:9419/mcp",
      "routable_url": "https://server-88.internal:9419/mcp"
    }
  ],
  "limits": {
    "max_results": 100,
    "context_lines": 3,
    "max_response_bytes": 131072,
