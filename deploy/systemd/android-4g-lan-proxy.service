[Unit]
Description=Share Android 4G through LAN via SOCKS5/HTTP CONNECT
After=network-online.target android-s21-gptadmin-bridge.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/gptadmin/bin/android-4g-lan-proxy.sh
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/etc/gptadmin /home/admin /opt/gptadmin

[Install]
WantedBy=multi-user.target
