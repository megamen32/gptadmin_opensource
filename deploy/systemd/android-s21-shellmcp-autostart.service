[Unit]
Description=GPTAdmin S21 ShellMCP exact-owner reconciler
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/libexec/gptadmin/android-s21-shellmcp-autostart.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/gptadmin
