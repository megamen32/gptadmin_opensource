#!/bin/sh /etc/rc.common
START=98
STOP=79
USE_PROCD=1
CONFIG=/etc/haproxy-became.cfg
start_service() {
    procd_open_instance
    # A valid ingress must recover even after the default five retries.
    procd_set_param respawn 3600 5 0
    procd_set_param file "$CONFIG"
    procd_set_param reload_signal USR2
    procd_set_param command /usr/sbin/haproxy -q -W -db -f "$CONFIG"
    procd_close_instance
}
